# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-OR-ANON-KEY
SUPABASE_BUCKET=inventory-media

# ---- Groq (cloud LLM -- used by the agent, see app/services/agent/llm.py) ----
GROQ_API_KEY=YOUR-GROQ-API-KEY
GROQ_MODEL=openai/gpt-oss-120b

# ---- Ollama (local LLM, kept as fallback / for other local-model experiments) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Whisper ----
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Edge TTS ----
TTS_VOICE=en-US-JennyNeural

# ---- FashionCLIP ----
FASHION_CLIP_MODEL=patrickjohncyh/fashion-clip

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
