# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-OR-ANON-KEY
SUPABASE_BUCKET=inventory-media

# ---- Groq (cloud LLM -- used by the agent, see app/services/agent/llm.py) ----
GROQ_API_KEY=YOUR-GROQ-API-KEY
# This is the model the agent's prompts/schema were actually built and tuned
# against (see llm.py's docstring) -- llama-3.3-70b-versatile was previously
# listed here but is a decommissioned Groq model as of this writing and 404s
# on every call; don't reintroduce it without checking Groq's current model list.
# Structured/tool-calling turns. Keep this on 120b: 20b was unreliable for
# structured output (see config.py).
GROQ_MODEL=openai/gpt-oss-120b
# Plain chit-chat + item explanations. A different model = a separate
# free-tier daily token quota. Leave empty to use GROQ_MODEL for everything.
GROQ_FAST_MODEL=openai/gpt-oss-20b
# "Path B" experiment only (see app/services/agent/graph_native.py) -- a
# smaller model for native bind_tools() tool-calling, compared against
# Path A's structured-output loop on GROQ_MODEL above. Confirmed live via
# this account's actual Groq /models list -- do not swap to a guessed
# model name (this project has 404'd on two guessed/decommissioned names).
GROQ_NATIVE_MODEL=openai/gpt-oss-20b

# ---- Ollama (local LLM, kept as fallback / for other local-model experiments) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Whisper ----
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Edge TTS ----
TTS_VOICE=en-US-JennyNeural

# ---- Fashion CLIP ----
# Default: Marqo/marqo-fashionCLIP (Apache-2.0, ViT-B-16, 512-dim, +57% eval
# gain over patrickjohncyh/fashion-clip). Loaded via open_clip.
FASHION_CLIP_MODEL=Marqo/marqo-fashionCLIP

# ---- Weather (Module 4 -- optional) ----
# Free tier, no card required: https://openweathermap.org/api
# Leave blank to disable -- get_weather() and recommend_clothes' weather
# nudge both degrade gracefully with no error when this is empty.
OPENWEATHER_API_KEY=
# The MIRROR's location (weather is about where the store is, not the
# customer) -- a city name OpenWeatherMap can resolve, or switch to lat/lon
# if the city is ambiguous.
MIRROR_LOCATION=New York,US

# ---- Demo ----
# "female"/"male" locks every scan to one department (demo videos). Empty =
# detect per scan with the gender ensemble.
FORCE_GENDER=

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
